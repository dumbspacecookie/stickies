#!/bin/sh
# Refuse to push code that has not passed the gate.
#
# A public push IS a release here: .claude-plugin/marketplace.json has "source": "./", so
# `claude plugin marketplace add dumbspacecookie/stickies` serves whatever is at HEAD. There is no
# staging step to catch things in — the push is the ship.
#
# ARMING. `core.hooksPath` lives in .git/config, which is not a tracked file, so this hook does not
# travel with a clone. `npm install` arms it (package.json's `prepare` script), and `npm run gate`
# fails if this clone is not armed. By hand, once:  git config core.hooksPath .githooks
# This file must also be committed executable (mode 100755) or POSIX git will not run it; the gate
# checks that too.
#
# Deliberate override:    STICKIES_SKIP_GATE=1 git push   (say why in the commit, not in your head)

if [ "$STICKIES_SKIP_GATE" = "1" ]; then
  echo "pre-push: gate SKIPPED via STICKIES_SKIP_GATE=1" >&2
  exit 0
fi

# --- does the gate describe what is being pushed? --------------------------------------------
#
# Every check in scripts/gate.mjs reads the WORKING TREE. A push sends COMMITS. Those are the same
# code only when the commit being pushed is HEAD and the tree is clean — otherwise a green gate is
# a true statement about code that is not the code leaving the machine. This hook used to run the
# gate and nothing else, so stale committed code plus an uncommitted local fix read as green: the
# gate examined the fix, the remote received the staleness, and both halves were honest.
#
# Rather than pretend to check commits it cannot check, the hook refuses the cases where the two
# differ, and says which one it is.
refs=$(cat)
head_sha=$(git rev-parse HEAD 2>/dev/null)
pushing=0
mismatch=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  case "$local_sha" in
    *[!0]*) ;;          # a real commit
    *) continue ;;      # all zeros: this ref is being DELETED, there is no code to gate
  esac
  pushing=1
  if [ "$local_sha" != "$head_sha" ]; then
    mismatch="$mismatch$local_ref -> ${local_sha%${local_sha#????????}}
"
  fi
done <<EOF
$refs
EOF

if [ "$pushing" = "0" ]; then
  echo "pre-push: nothing but ref deletions — no code to gate" >&2
  exit 0
fi

if [ -n "$mismatch" ]; then
  echo "" >&2
  echo "pre-push: BLOCKED — you are pushing commits that are not HEAD:" >&2
  printf '  %s' "$mismatch" >&2
  echo "  HEAD is ${head_sha%${head_sha#????????}}" >&2
  echo "" >&2
  echo "  The gate can only inspect the working tree, so it would be telling you about" >&2
  echo "  different code than the code you are about to publish. Check out what you mean" >&2
  echo "  to push and push that, or STICKIES_SKIP_GATE=1 to override." >&2
  exit 1
fi

if ! git diff --quiet HEAD -- 2>/dev/null; then
  echo "" >&2
  echo "pre-push: BLOCKED — the working tree differs from HEAD:" >&2
  git --no-pager diff --name-status HEAD -- | sed 's/^/  /' >&2
  echo "" >&2
  echo "  The gate reads those files, the push sends the commit. A green gate here would be" >&2
  echo "  a statement about code nobody is publishing. Commit or stash first." >&2
  exit 1
fi

untracked=$(git ls-files --others --exclude-standard -- src scripts test hooks commands .githooks)
if [ -n "$untracked" ]; then
  echo "" >&2
  echo "pre-push: BLOCKED — untracked source files the gate reads but the push does not carry:" >&2
  printf '%s\n' "$untracked" | sed 's/^/  /' >&2
  echo "" >&2
  echo "  Commit them, ignore them, or delete them." >&2
  exit 1
fi

echo "pre-push: running the gate (npm run gate)…" >&2
if ! npm run --silent gate; then
  echo "" >&2
  echo "pre-push: BLOCKED — the gate failed. Fix it, or STICKIES_SKIP_GATE=1 to override." >&2
  exit 1
fi
exit 0
